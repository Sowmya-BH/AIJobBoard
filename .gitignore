# ── Secrets / env ───────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/

# ── Virtual environments ────────────────────────────────────────
myenv/
venv/
.venv/

# ── OS / editor ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ────────────────────────────────────────────────────────
*.log

# ── Databases / data (all external now: MongoDB Atlas + Qdrant) ──
# No SQLite is used or shipped anymore — ignore every local DB.
*.db
*.sqlite3
# The raw scrape JSON is huge and loaded once into Atlas — never commit it.
*.json
!package.json
!**/tsconfig.json
data/*.json

# ── Docker ──────────────────────────────────────────────────────
.docker/